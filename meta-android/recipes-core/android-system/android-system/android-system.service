[Unit]
Description=Android System Container
Before=network.target ofono.service pulseaudio.service sensorfwd.service
# The compositor must not start until the Android side is up. libhybris prefers
# the HIDL composer HAL over hwbinder, but silently falls back to dlopen'ing the
# hwcomposer module in-process if that service is not registered yet - and the
# fallback opens /dev/dri/card0 directly, creating a second HWCSession that
# fights the composer service for DRM master. The compositor's render thread
# then waits forever on fences delivered to the other process: input keeps
# arriving, no frames are produced, and the UI is unusable at 0% CPU.
Before=surface-manager-daemon.service

[Service]
Type=simple
# Map and mount the device's own Android partitions (super/dynamic partitions,
# vendor, vendor_dlkm, odm, and whatever the vendor's fstab asks for) before the
# container's init can look for them.
ExecStartPre=/usr/bin/mount-android.sh
# -o, so LXC's own diagnostics land in a file instead of being lost. Without it
# the only sign of a container that will not start is the service timing out in
# start-post: a broken config, a failed mount or an init that dies on exec are
# all invisible. A stale @LXC_ARCH@ in the config produced nothing but a
# timeout until this log was read by hand.
ExecStart=/usr/bin/lxc-start -n android -l DEBUG -o /var/log/lxc-android.log -- /init
# The post steps are best-effort readiness probes, not part of bringing the
# container up (that is ExecStart, above). They must never be able to fail the
# unit: start-android-hals waits on the composer HAL via lshal, which has been
# seen to crash (coredump) on some bases, and wait-for-android polls getprop.
# A "-" prefix keeps a non-zero exit or a crash from marking android-system
# failed - which used to cascade into luneos-device-config being skipped and the
# device coming up on the placeholder input config (no touch, no power key).
ExecStartPost=-/usr/bin/start-android-hals.sh
ExecStartPost=-/usr/bin/wait-for-android.sh
ExecStop=/usr/bin/lxc-stop -n android -t 5
RemainAfterExit=yes
# Both post scripts are internally bounded (the graphics-HAL wait ~30s, the
# getprop wait 120s), so give the whole start comfortably more than their sum.
# The default 90s is shorter than the getprop wait alone, so a slow container
# was killed mid-probe and reported as a start-post timeout - a hard failure the
# "-" prefixes above cannot suppress. A generous finite ceiling still catches a
# genuinely wedged lxc-start.
TimeoutStartSec=300
# Never kill the android system when we're on low memory
OOMScoreAdjust=-1000

[Install]
RequiredBy=basic.target
