From 11643c9f3325f2ea86b560478973f94431c93960 Mon Sep 17 00:00:00 2001
From: Alan Morford <alanmorford@gmail.com>
Date: Fri, 25 Sep 2026 07:37:16 +0200
Subject: [PATCH 2/2] hwkeyboard: athena: Shift latches on a tap

The KEY2's Shift keys (KEY_LEFTSHIFT, KEY_RIGHTSHIFT) now latch for one
key on a tap and lock on a double tap, as on its stock Android, instead
of only applying while held.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 data/hwkeyboard/athena-azerty.json | 4 ++++
 data/hwkeyboard/athena-qwerty.json | 4 ++++
 data/hwkeyboard/athena-qwertz.json | 4 ++++
 3 files changed, 12 insertions(+)

diff --git a/data/hwkeyboard/athena-azerty.json b/data/hwkeyboard/athena-azerty.json
index c0def26..5ded368 100644
--- a/data/hwkeyboard/athena-azerty.json
+++ b/data/hwkeyboard/athena-azerty.json
@@ -13,6 +13,10 @@
     "symKeys": [
         100
     ],
+    "shiftKeys": [
+        42,
+        54
+    ],
     "lockOnDoubleTap": true,
     "levels": {
         "base": {
diff --git a/data/hwkeyboard/athena-qwerty.json b/data/hwkeyboard/athena-qwerty.json
index 08cf7b4..15b0147 100644
--- a/data/hwkeyboard/athena-qwerty.json
+++ b/data/hwkeyboard/athena-qwerty.json
@@ -13,6 +13,10 @@
     "symKeys": [
         100
     ],
+    "shiftKeys": [
+        42,
+        54
+    ],
     "lockOnDoubleTap": true,
     "levels": {
         "base": {
diff --git a/data/hwkeyboard/athena-qwertz.json b/data/hwkeyboard/athena-qwertz.json
index 5377896..b658460 100644
--- a/data/hwkeyboard/athena-qwertz.json
+++ b/data/hwkeyboard/athena-qwertz.json
@@ -13,6 +13,10 @@
     "symKeys": [
         100
     ],
+    "shiftKeys": [
+        42,
+        54
+    ],
     "lockOnDoubleTap": true,
     "levels": {
         "base": {
