#!/bin/sh
# athena-kbd-backlight - KEY2 keyboard backlight, driven by the ambient light
# sensor the way BlackBerry's Android does it: brighter in the dark, dimmer in
# a lit room, off in daylight, and off whenever the display is dimmed or off.
#
# LunaDisplayManager already computes a keypad brightness, but hands it to a nyx
# LED controller that has no keypad device on hybris ("LedControlKeypad returns
# NULL"), so nothing reaches the aw2027 LED driver at i2c 2-0064. Writing
# /sys/class/leds/keyboard-backlight drives all three of its channels.
#
# Inputs, merged into one stream and told apart by content:
#   com.palm.display/control/status   first reply "state": on|off|dimmed,
#                                     then "event": displayOn|displayOff|displayDimmed|...
#   com.palm.ambientLightSensor/...   first reply "current": N, then "region": N
#     N: 0 undefined, 1 dark, 2 dim, 3 indoor, 4 outdoor, 5 sunny

LED=/sys/class/leds/keyboard-backlight/brightness

# Brightness (0-255) per ALS region; override in /etc/default/athena-kbd-backlight.
KBD_UNDEFINED=48
KBD_DARK=96
KBD_DIM=64
KBD_INDOOR=32
KBD_OUTDOOR=0
KBD_SUNNY=0
[ -r /etc/default/athena-kbd-backlight ] && . /etc/default/athena-kbd-backlight

display=on
region=0
last=

set_led() {
    [ "$1" = "$last" ] && return
    echo "$1" > $LED && last=$1
    echo "display=$display region=$region -> $1"
}

apply() {
    if [ "$display" != on ]; then
        set_led 0
        return
    fi
    case "$region" in
        1) set_led $KBD_DARK ;;
        2) set_led $KBD_DIM ;;
        3) set_led $KBD_INDOOR ;;
        4) set_led $KBD_OUTDOOR ;;
        5) set_led $KBD_SUNNY ;;
        *) set_led $KBD_UNDEFINED ;;
    esac
}

case "$1" in
    off) echo 0 > $LED; exit 0 ;;
esac

sub() { tail -f /dev/null | luna-send -i "$1" '{"subscribe":true}' 2>/dev/null; }

# Either luna-send exiting (a service restarted) ends the loop; systemd restarts
# the unit and ExecStopPost turns the LEDs off in between.
{
    sub luna://com.palm.display/control/status &
    sub luna://com.palm.ambientLightSensor/control/status &
    wait -n 2>/dev/null || wait
} | while read -r line; do
    case "$line" in
        *'"state"'*'"on"'*|*'"event"'*'"displayOn"'*)      display=on ;;
        *'"state"'*'"dimmed"'*|*'"event"'*'"displayDimmed"'*) display=dimmed ;;
        *'"state"'*'"off"'*|*'"event"'*'"displayOff"'*)    display=off ;;
        *'"region"'*|*'"current"'*)
            region=$(echo "$line" | sed -n 's/.*"\(region\|current\)":\([0-9]*\).*/\2/p') ;;
        *) continue ;;
    esac
    apply
done
