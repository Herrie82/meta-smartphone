From 26549150be5079fea01d8cb6927eb6d6714f4f2d Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Sat, 21 Feb 2026 18:05:02 +0100
Subject: [PATCH 8/9] freedreno/a2xx: set SQ_INTERPOLATOR_CNTL after
 SQ_PROGRAM_CNTL

Set SQ_INTERPOLATOR_CNTL in fd2_program_emit() AFTER SQ_PROGRAM_CNTL.
The hardware may require the interpolator control to be configured
after the shader program is set up.

Keep the register write in fd2_emit_restore() as a baseline
initialization, and ALSO set it in fd2_program_emit() after
SQ_PROGRAM_CNTL for proper sequencing. This ensures the register
is always set correctly regardless of dirty flag state.

This addresses faceted shading artifacts where interpolation
wasn't being set up correctly after shader program changes.

Upstream-Status: Pending
Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
---
 src/gallium/drivers/freedreno/a2xx/fd2_program.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_program.c b/src/gallium/drivers/freedreno/a2xx/fd2_program.c
index b86f231..f03d86b 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_program.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_program.c
@@ -233,6 +233,16 @@ fd2_program_emit(struct fd_context *ctx, struct fd_ringbuffer *ring,
                COND(fp && fp->need_param, A2XX_SQ_PROGRAM_CNTL_PARAM_GEN) |
                COND(!fp, A2XX_SQ_PROGRAM_CNTL_GEN_INDEX_VTX));
 
+   /* Set SQ_INTERPOLATOR_CNTL AFTER SQ_PROGRAM_CNTL.
+    * This register controls whether each varying uses smooth or flat
+    * interpolation. 0xffffffff = all varyings use smooth interpolation.
+    * Hardware may require this ordering for proper interpolation setup.
+    * Also set in fd2_emit_restore() for baseline init.
+    */
+   OUT_PKT3(ring, CP_SET_CONSTANT, 2);
+   OUT_RING(ring, CP_REG(REG_A2XX_SQ_INTERPOLATOR_CNTL));
+   OUT_RING(ring, 0xffffffff);
+
    /* Debug: log shader program state for interpolation debugging */
    if (FD_DBG(MSGS)) {
       mesa_logi("A2XX: SQ_PROGRAM_CNTL: vs_gprs=0x%02x(%d) fs_gprs=0x%02x(%d) "
