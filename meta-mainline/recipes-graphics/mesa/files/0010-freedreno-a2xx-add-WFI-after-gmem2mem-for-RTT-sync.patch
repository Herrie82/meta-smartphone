From bce430eadbd49654e26e66eb0a9437f41d98af5a Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Tue, 10 Feb 2026 20:45:19 +0100
Subject: [PATCH] freedreno/a2xx: add cache flush and WFI for GMEM sync on A22X

The gmem2mem operation uses RB_COPY which is a DMA operation from
GMEM to system memory. The Command Processor (CP) can finish
processing commands before the Render Backend (RB) completes the
actual DMA transfer.

Without explicit cache flush and wait-for-idle, the batch fence
can signal before the texture data is fully written to system
memory. This causes intermittent corruption when the texture is
sampled in a subsequent render pass (e.g., blur effects,
render-to-texture).

Add cache flush + WFI synchronization in three locations:
1. After gmem2mem (tile store) - ensures RB_COPY DMA is complete
2. Before mem2gmem render (tile restore) - ensures GMEM is ready
3. Before sysmem render - ensures previous ops are complete

This matches KGSL behavior where CACHE_FLUSH_TS is issued after
every ringbuffer submission, ensuring all GPU work is complete
and visible to memory before proceeding.

Symptoms fixed:
- Intermittent partial blur in glmark2 blur benchmark
- Render-to-texture corruption that "works sometimes"
- Multi-pass rendering artifacts on A22X (Adreno 220/225)

Upstream-Status: Pending
Co-Authored-By: Claude Opus 4.5 <noreply@anthropic.com>
---
 src/gallium/drivers/freedreno/a2xx/fd2_gmem.c | 45 ++++++++++++++++++-
 1 file changed, 44 insertions(+), 1 deletion(-)

diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c b/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c
index 6ac12b7..8759f16 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c
@@ -42,6 +42,20 @@
 #include "fd2_util.h"
 #include "fd2_zsa.h"
 
+/* Emit GPU cache flush to ensure all rendering is complete and visible
+ * to memory. This matches KGSL behavior which issues CACHE_FLUSH_TS after
+ * every ringbuffer submission. We do multiple flushes for reliability on
+ * A2XX hardware, same as emit_cacheflush() in fd2_draw.c.
+ */
+static void
+fd2_gmem_cache_flush(struct fd_ringbuffer *ring)
+{
+   for (unsigned i = 0; i < 12; i++) {
+      OUT_PKT3(ring, CP_EVENT_WRITE, 1);
+      OUT_RING(ring, CACHE_FLUSH);
+   }
+}
+
 static uint32_t
 fmt2swap(enum pipe_format format)
 {
@@ -209,6 +223,19 @@ prepare_tile_fini_ib(struct fd_batch *batch) assert_dt
    if (batch->resolve & FD_BUFFER_COLOR)
       emit_gmem2mem_surf(batch, gmem->cbuf_base[0], pfb->cbufs[0]);
 
+   /* A22X: flush GPU caches and wait for RB_COPY DMA to complete before
+    * signaling fence. Without this, the fence can signal before the
+    * texture data is fully written to system memory, causing RTT
+    * corruption (e.g., intermittent blur artifacts in glmark2).
+    *
+    * KGSL issues CACHE_FLUSH_TS after every submission. We replicate
+    * this by issuing CACHE_FLUSH events followed by WFI.
+    */
+   if (!is_a20x(ctx->screen)) {
+      fd2_gmem_cache_flush(ring);
+      OUT_WFI(ring);
+   }
+
    OUT_PKT3(ring, CP_SET_CONSTANT, 2);
    OUT_RING(ring, CP_REG(REG_A2XX_RB_MODECONTROL));
    OUT_RING(ring, A2XX_RB_MODECONTROL_EDRAM_MODE(COLOR_DEPTH));
@@ -393,7 +420,14 @@ fd2_emit_tile_mem2gmem(struct fd_batch *batch,
                      A2XX_PA_CL_VTE_CNTL_VPORT_Z_SCALE_ENA |
                      A2XX_PA_CL_VTE_CNTL_VPORT_Z_OFFSET_ENA);
 
-   /* TODO blob driver seems to toss in a CACHE_FLUSH after each DRAW_INDX.. */
+   /* A22X: flush caches and wait for mem2gmem to complete before rendering.
+    * This ensures system memory data is fully loaded into GMEM before the
+    * render pass begins. Without this, the render may use stale GMEM data.
+    */
+   if (!is_a20x(ctx->screen)) {
+      fd2_gmem_cache_flush(ring);
+      OUT_WFI(ring);
+   }
 }
 
 static void
@@ -453,6 +487,15 @@ fd2_emit_sysmem_prep(struct fd_batch *batch)
 
    fd2_emit_restore(ctx, ring);
 
+   /* A22X: flush caches and wait for idle before sysmem rendering.
+    * This ensures any previous GPU operations are complete and visible
+    * in system memory before we start rendering directly to system memory.
+    */
+   if (!is_a20x(ctx->screen)) {
+      fd2_gmem_cache_flush(ring);
+      OUT_WFI(ring);
+   }
+
    OUT_PKT3(ring, CP_SET_CONSTANT, 2);
    OUT_RING(ring, CP_REG(REG_A2XX_RB_SURFACE_INFO));
    OUT_RING(ring, A2XX_RB_SURFACE_INFO_SURFACE_PITCH(pitch));
