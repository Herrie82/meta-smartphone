From 1a45f13dce8bf3a72f8eabfe601c851cb888cbde Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 11 Feb 2026 07:08:39 +0100
Subject: [PATCH] freedreno/a2xx: initialize A220 registers and keep clocks
 enabled

The A220_RB_LRZ_VSC_CONTROL (0x2209) and A220_GRAS_CONTROL (0x2210)
registers on Adreno 220/225 (A22X) GPUs are not initialized by freedreno,
leaving them with undefined values after GPU power-on.

KGSL (the proprietary Qualcomm GPU driver) initializes all GPU registers
to 0 via its 18KB shadow memory mechanism during context creation.
Freedreno doesn't have register shadowing, so it relies on explicit
initialization in fd2_emit_restore().

RB_LRZ_VSC_CONTROL controls Low Resolution Z and Visibility Stream.
When uninitialized, random bits can cause incorrect depth testing or
primitive visibility decisions.

GRAS_CONTROL controls the Graphics Rasterizer. When uninitialized,
random bits can affect how primitives are rasterized, causing faceted
instead of smooth shading.

Keep PM_OVERRIDE2 at 0xfff (all clocks enabled) for A22X to avoid
display underruns. KGSL uses 0x1a0 with clock gating, but freedreno
doesn't have the same fine-grained power management.

Symptoms fixed:
- Random faceted vs smooth surfaces in glmark2 build benchmark
- Intermittent rendering differences on identical shader code

Upstream-Status: Pending
Co-Authored-By: Claude Opus 4.5 <noreply@anthropic.com>
---
 src/gallium/drivers/freedreno/a2xx/fd2_emit.c | 27 ++++++++++++++++++-
 1 file changed, 26 insertions(+), 1 deletion(-)

diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_emit.c b/src/gallium/drivers/freedreno/a2xx/fd2_emit.c
index 0771587..1ceb900 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_emit.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_emit.c
@@ -431,6 +431,24 @@ fd2_emit_restore(struct fd_context *ctx, struct fd_ringbuffer *ring)
       OUT_PKT3(ring, CP_SET_CONSTANT, 2);
       OUT_RING(ring, CP_REG(REG_A2XX_VGT_VERTEX_REUSE_BLOCK_CNTL));
       OUT_RING(ring, 0x0000003b);
+
+      /* A22X: Initialize LRZ/VSC and GRAS control registers to deterministic
+       * state. KGSL initializes all registers to 0 via shadow memory, but
+       * freedreno doesn't have register shadowing. Without explicit
+       * initialization, these registers retain random values after GPU
+       * power-on, causing intermittent rendering issues (e.g., faceted
+       * instead of smooth surfaces in glmark2 build benchmark).
+       *
+       * RB_LRZ_VSC_CONTROL controls Low Resolution Z and Visibility Stream.
+       * GRAS_CONTROL controls the Graphics Rasterizer.
+       */
+      OUT_PKT3(ring, CP_SET_CONSTANT, 2);
+      OUT_RING(ring, CP_REG(REG_A2XX_A220_RB_LRZ_VSC_CONTROL));
+      OUT_RING(ring, 0x00000000);
+
+      OUT_PKT3(ring, CP_SET_CONSTANT, 2);
+      OUT_RING(ring, CP_REG(REG_A2XX_A220_GRAS_CONTROL));
+      OUT_RING(ring, 0x00000000);
    }
 
    /* enable perfcntrs */
@@ -440,7 +458,14 @@ fd2_emit_restore(struct fd_context *ctx, struct fd_ringbuffer *ring)
    /* note: perfcntrs don't work without the PM_OVERRIDE bit */
    OUT_PKT0(ring, REG_A2XX_RBBM_PM_OVERRIDE1, 2);
    OUT_RING(ring, 0xffffffff);
-   OUT_RING(ring, 0x00000fff);
+   /* A22X: Keep all clocks enabled (0xfff) to avoid display underruns.
+    * KGSL uses 0x1a0 with clock gating, but freedreno doesn't have the
+    * same fine-grained power management, so we keep clocks always on.
+    */
+   if (is_a20x(ctx->screen))
+      OUT_RING(ring, 0x00000000);
+   else
+      OUT_RING(ring, 0x00000fff);
 
    OUT_PKT0(ring, REG_A2XX_TP0_CHICKEN, 1);
    OUT_RING(ring, 0x00000002);
