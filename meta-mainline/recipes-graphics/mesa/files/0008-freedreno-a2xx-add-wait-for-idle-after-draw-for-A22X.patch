From 93dd7cfe909ff6bd5366609debb038c292aee3a0 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Tue, 10 Feb 2026 07:12:36 +0100
Subject: [PATCH] freedreno/a2xx: add wait-for-idle after draw for A22X

A20X already has OUT_WFI after each draw to prevent hangs. A22X was
missing this, relying only on UNKNOWN_2010 register write. This may
cause state corruption between draws, leading to random rendering
artifacts (geometry and texture issues).

Add OUT_WFI for A22X as well to ensure GPU is idle before proceeding
to the next draw operation.

Upstream-Status: Pending
Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
---
 src/gallium/drivers/freedreno/a2xx/fd2_draw.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_draw.c b/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
index d9669bc..54c0f4d 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
@@ -151,6 +151,8 @@ draw_impl(struct fd_context *ctx, const struct pipe_draw_info *info,
       /* not sure why this is required, but it fixes some hangs */
       OUT_WFI(ring);
    } else {
+      /* A22X: also need WFI to prevent state corruption between draws */
+      OUT_WFI(ring);
       OUT_PKT3(ring, CP_SET_CONSTANT, 2);
       OUT_RING(ring, CP_REG(REG_A2XX_UNKNOWN_2010));
       OUT_RING(ring, 0x00000000);
-- 
2.43.0

