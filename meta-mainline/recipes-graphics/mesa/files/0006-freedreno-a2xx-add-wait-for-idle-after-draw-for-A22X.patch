From fd0bee1a60ea5d66bbcd2a599714dae650a6f347 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Sat, 21 Feb 2026 18:04:00 +0100
Subject: [PATCH 6/9] freedreno/a2xx: add wait-for-idle after draw for A22X

Upstream-Status: Inappropriate [debug]
---
 src/gallium/drivers/freedreno/a2xx/fd2_draw.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_draw.c b/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
index c7ee307..5f22012 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
@@ -133,6 +133,8 @@ draw_impl(struct fd_context *ctx, const struct pipe_draw_info *info,
       /* not sure why this is required, but it fixes some hangs */
       OUT_WFI(ring);
    } else {
+      /* A22X: also need WFI to prevent state corruption between draws */
+      OUT_WFI(ring);
       OUT_PKT3(ring, CP_SET_CONSTANT, 2);
       OUT_RING(ring, CP_REG(REG_A2XX_UNKNOWN_2010));
       OUT_RING(ring, 0x00000000);
