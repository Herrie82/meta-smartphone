From 73283ff102c8be87213ebac0bb2b35b3bd03464b Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 13 May 2026 14:22:42 +0200
Subject: [PATCH] freedreno/a2xx: emit end-of-tile-loop CP_EVENT_WRITE
 deallocation events (A22X)

Diagnostic for the A22X period-16 render cycle isolated to MMIO
register word 0x0ee2 (reports/gemini-summary-2026-05-13-cycle-
register.md).  Register advances deterministically per submit -
1 in 16 caps produces the correct frame (slot 0 = boot state).

The A22X codepath has no emit_tile_fini hook set, meaning Mesa
never tells the GPU "I'm done with this slot" at end of submit.
webOS libGLESv2 emits CP_EVENT_WRITE for events 0x06 (CACHE_FLUSH),
0x17 (PERFCOUNTER_START), 0x18 (PERFCOUNTER_STOP), 0x1c
(FACENESS_FLUSH) - none of which Mesa emits.  HTC/Samsung/Xiaomi
emit ZERO CP_EVENT_WRITE - they take a different cmdstream path
entirely.

This patch adds a fd2_emit_tile_fini for A22X that conditionally
emits the missing "release slot" events based on env vars, so we
can bisect which event(s) collapse the cycle:

  FD2_END_CTX_DONE     CP_EVENT_WRITE 0x05 (CONTEXT_DONE)
  FD2_END_FACENESS     CP_EVENT_WRITE 0x1c (FACENESS_FLUSH)
  FD2_END_DEALLOC      0x00 (VS_DEALLOC) + 0x01 (PS_DEALLOC)

Hook registered in fd2_gmem_init.  Default (no env vars set) =
byte-identical to prior behaviour - the hook returns immediately
without emitting any extra packets.

Expected outcomes:
  a) One of the events collapses the cycle (all 16 caps produce
     the same hash, ideally the 5adc3160 correct frame) -> we have
     identified the missing deallocation packet.  Make it
     unconditional in a follow-up.
  b) None of them help -> Gemini's allocator-leak model is wrong
     OR the events need to be emitted per-DRAW not per-batch.
  c) Multiple help in combination -> ship the union.

References:
  - reports/gemini-summary-2026-05-13-cycle-register.md (both rounds)
  - memory/project_cycle_register_0xee2.md
  - kernel/drivers/gpu/drm/msm/adreno/a2xx_gpu.c::a220_registers[]
    explicitly dumps 0x0ee0..0x0ee2 - qcom devs knew the register
    existed but mesa's a2xx.xml has no definition for it

Upstream-Status: Pending

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
---
 src/gallium/drivers/freedreno/a2xx/fd2_gmem.c | 65 +++++++++++++++++++
 1 file changed, 65 insertions(+)

diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c b/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c
index 2db72d06841..3647885dbe3 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_gmem.c
@@ -578,6 +578,70 @@ fd2_emit_sysmem_prep(struct fd_batch *batch)
    fd_context_all_dirty(ctx);
 }
 
+/* end of tile loop - emit "release slot" events to deallocate the 16-entry
+ * VPC / TC / faceness pool that the GPU consumes one slot of per Mesa batch.
+ *
+ * Background (reports/gemini-summary-2026-05-13-cycle-register.md):
+ *   Register word 0x0ee2 advances deterministically per Mesa render with
+ *   period 16 - one slot per submit, wrap to slot 0 every 16th render.
+ *   1 in 16 caps produces the correct frame (slot 0 = boot state).
+ *   Mesa is leaking pool slots; vendor drivers don't (they emit different
+ *   events or use a "global" submit path).
+ *
+ * webOS strings survey: emits CP_EVENT_WRITE for 0x06 (CACHE_FLUSH),
+ *   0x17 (PERFCOUNTER_START), 0x18 (PERFCOUNTER_STOP), 0x1c
+ *   (FACENESS_FLUSH).  Mesa freedreno A2XX emits only 0x16
+ *   (CACHE_FLUSH_AND_INV_EVENT).
+ *
+ * Three env vars bisect which event(s) collapse the cycle:
+ *   FD2_END_CTX_DONE     emit CP_EVENT_WRITE 0x05 (CONTEXT_DONE)
+ *   FD2_END_FACENESS     emit CP_EVENT_WRITE 0x1c (FACENESS_FLUSH)
+ *   FD2_END_DEALLOC      emit 0x00 (VS_DEALLOC) + 0x01 (PS_DEALLOC)
+ *
+ * Default (no env vars) = byte-identical to prior behaviour (no events).
+ */
+static void
+fd2_emit_tile_fini(struct fd_batch *batch) assert_dt
+{
+   struct fd_context *ctx = batch->ctx;
+   struct fd_ringbuffer *ring = batch->gmem;
+
+   if (!is_a22x(ctx->screen))
+      return;
+
+   if (getenv("FD2_END_CTX_DONE")) {
+      OUT_PKT3(ring, CP_EVENT_WRITE, 1);
+      OUT_RING(ring, 0x05);  /* CONTEXT_DONE */
+   }
+
+   if (getenv("FD2_END_FACENESS")) {
+      OUT_PKT3(ring, CP_EVENT_WRITE, 1);
+      OUT_RING(ring, 0x1c);  /* FACENESS_FLUSH */
+   }
+
+   /* FD2_END_DEALLOC=N emits N pairs of VS_DEALLOC + PS_DEALLOC.
+    *
+    * Round-3 test showed N=1 (single pair) shifts the period-16 cycle
+    * by exactly 1 cap (5adc3160 moves cap 1 -> cap 2).  Gemini round-4
+    * hypothesis: each render consumes 2 slots (binning draw + render
+    * draw), so we need N=2 to pin the cycle.  Test by setting
+    * FD2_END_DEALLOC=2 (or higher to verify saturation).
+    * FD2_END_DEALLOC=1 keeps the prior single-pair behaviour for
+    * direct comparison.
+    */
+   const char *dealloc_env = getenv("FD2_END_DEALLOC");
+   if (dealloc_env) {
+      int n = atoi(dealloc_env);
+      if (n <= 0) n = 1;
+      for (int i = 0; i < n; i++) {
+         OUT_PKT3(ring, CP_EVENT_WRITE, 1);
+         OUT_RING(ring, 0x00);  /* VS_DEALLOC */
+         OUT_PKT3(ring, CP_EVENT_WRITE, 1);
+         OUT_RING(ring, 0x01);  /* PS_DEALLOC */
+      }
+   }
+}
+
 /* before first tile */
 static void
 fd2_emit_tile_init(struct fd_batch *batch) assert_dt
@@ -1453,4 +1517,5 @@ fd2_gmem_init(struct pipe_context *pctx) disable_thread_safety_analysis
    ctx->emit_tile_mem2gmem = fd2_emit_tile_mem2gmem;
    ctx->emit_tile_renderprep = fd2_emit_tile_renderprep;
    ctx->emit_tile_gmem2mem = fd2_emit_tile_gmem2mem;
+   ctx->emit_tile_fini = fd2_emit_tile_fini;
 }
-- 
