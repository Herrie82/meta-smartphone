From f03986e5f16421dd1f9e8750e8bb398828453eb5 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Sun, 22 Feb 2026 20:44:55 +0100
Subject: [PATCH] freedreno/a2xx: add WFI after vertex buffer setup on A22X

Add Wait-For-Idle after emitting vertex buffer addresses on
Adreno 220/225 to ensure buffer addresses are fully registered
before vertex fetch begins.

This is another timing workaround for the intermittent faceted
rendering issue on A22X. The vertex fetch unit may start reading
from buffers before the addresses are fully written to the
constant registers.

Upstream-Status: Pending [hardware workaround]
---
 src/gallium/drivers/freedreno/a2xx/fd2_draw.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_draw.c b/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
index b8168d6..f5d6c3f 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_draw.c
@@ -143,6 +143,14 @@ emit_vertexbufs(struct fd_context *ctx) assert_dt
 
    fd2_emit_vertex_bufs(ctx->batch->draw, 0x78, bufs, vtx->num_elements);
    fd2_emit_vertex_bufs(ctx->batch->binning, 0x78, bufs, vtx->num_elements);
+
+   /* A22X workaround: WFI after vertex buffer setup to ensure buffer
+    * addresses are fully registered before vertex fetch begins.
+    */
+   if (is_a22x(ctx->screen)) {
+      OUT_WFI(ctx->batch->draw);
+      OUT_WFI(ctx->batch->binning);
+   }
 }
 
 static void
