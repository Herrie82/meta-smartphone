From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Wed, 11 Feb 2026 15:00:00 +0100
Subject: [PATCH] freedreno/a2xx: add register debug logging

Add debug logging for critical A2XX register values when
FD_MESA_DEBUG=msgs is set. This helps debug intermittent
rendering issues by showing what values are being written
to GPU registers at:
- GPU state restore (emit_restore)
- Draw calls (blend state, shader info)

Usage: FD_MESA_DEBUG=msgs glmark2-es2-drm 2>&1 | tee debug.log

Upstream-Status: Pending
Co-Authored-By: Claude Opus 4.5 <noreply@anthropic.com>
---
 src/gallium/drivers/freedreno/a2xx/fd2_emit.c | 45 +++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_emit.c b/src/gallium/drivers/freedreno/a2xx/fd2_emit.c
index 1ceb900..a2b3c02 100644
--- a/src/gallium/drivers/freedreno/a2xx/fd2_emit.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_emit.c
@@ -431,6 +431,47 @@ fd2_emit_tile_gmem2mem(struct fd_batch *batch, const struct fd_tile *tile)
 void
 fd2_emit_restore(struct fd_context *ctx, struct fd_ringbuffer *ring)
 {
+   static unsigned restore_count = 0;
+   restore_count++;
+
+   /* Debug: log critical register values being written */
+   DBG("======== A2XX Restore #%u ========", restore_count);
+   DBG("GPU: %s", is_a20x(ctx->screen) ? "A20X (Yamato)" : "A22X (Leia)");
+   DBG("SHADER REGS:");
+   DBG("  SQ_GPR_MANAGEMENT=0x00040400 (64 VS + 64 PS GPRs)");
+   DBG("  SQ_INST_STORE_MANAGMENT=0x00000180");
+   DBG("  SQ_INTERPOLATOR_CNTL=0xffffffff (all smooth)");
+   DBG("RENDER BACKEND:");
+   DBG("  RB_SAMPLE_POS=0x88888888");
+   DBG("  RB_COLOR_DEST_MASK=0xffffffff");
+   DBG("  RB_COLOR_MASK=0x0f (RGBA write)");
+   DBG("  RB_BLEND_ALPHA=0xff");
+   DBG("TEXTURE:");
+   DBG("  TP0_CHICKEN=0x00000002");
+   if (!is_a20x(ctx->screen)) {
+      DBG("A22X SPECIFIC:");
+      DBG("  A220_RB_LRZ_VSC_CONTROL=0x00000000");
+      DBG("  A220_GRAS_CONTROL=0x00000000");
+      DBG("  VGT_VERTEX_REUSE_BLOCK_CNTL=0x0000003b");
+      DBG("  RBBM_PM_OVERRIDE2=0x00000fff");
+   } else {
+      DBG("A20X SPECIFIC:");
+      DBG("  VGT_VERTEX_REUSE_BLOCK_CNTL=0x00000002");
+      DBG("  VGT_OUT_DEALLOC_CNTL=0x00000002");
+   }
+   DBG("================================");
+
+   /* Also log at intervals to track state over time */
+   if ((restore_count % 50) == 0) {
+      mesa_logi("A2XX: Restore #%u completed (GPU=%s)",
+                restore_count,
+                is_a20x(ctx->screen) ? "A20X" : "A22X");
+      mesa_logi("A2XX: SQ_GPR_MANAGEMENT=0x00040400, "
+                "SQ_INTERPOLATOR_CNTL=0xffffffff");
+   }
+
    OUT_PKT0(ring, REG_A2XX_TP0_CHICKEN, 1);
    OUT_RING(ring, 0x00000002);

@@ -555,6 +596,10 @@ fd2_emit_restore(struct fd_context *ctx, struct fd_ringbuffer *ring)
    OUT_RING(ring, 0x5f601000);
    OUT_RING(ring, 0x00000001);

+   /* Log before writing SQ_GPR_MANAGEMENT */
+   DBG("Writing SQ_GPR_MANAGEMENT=0x00040400 to ringbuffer");
+   DBG("  REG_DYNAMIC=0, REG_SIZE_PIX=64, REG_SIZE_VTX=64");
+
    /* A22X: Initialize SQ_GPR_MANAGEMENT to allocate 64 GPRs each for vertex
     * and pixel shaders. KGSL initializes this to 0x00040400. Without proper
     * initialization, a random value from GPU power-on could starve one

