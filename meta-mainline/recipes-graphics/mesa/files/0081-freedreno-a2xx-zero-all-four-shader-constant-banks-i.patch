From 3e2b1a7fed02cc795f31198eaf67103c0ddf6e8b Mon Sep 17 00:00:00 2001
From: Herman van Hazendonk <github.com@herrie.org>
Date: Fri, 8 May 2026 21:07:40 +0200
Subject: [PATCH] freedreno/a2xx: zero all four shader-constant banks in
 emit_restore (3/8 alignment experiment)

Adreno 2xx exposes four classes of shader-constant memory via
CP_SET_CONSTANT with type prefixes in the address word: type=0 ALU
vec4 floats, type=1 texture-fetch constants, type=2 booleans, type=3
loop control. Mesa freedreno's a2xx driver only ever emits type-0
(per-draw via fd2_program emit_consts) and type-1 (per-binding via
texture state). It never emits type-2 or type-3.

KGSL (the legacy proprietary kernel driver this silicon was originally
designed for) explicitly restores all four classes on every
per-context shadow restore - see kgsl_drawctxt.c build_regrestore_cmds,
which emits ALU=2048 dwords, TEX=192 dwords, BOOL=8 dwords (256 bool
flags) and LOOP=56 dwords on every context switch. Mainline freedreno
doesn't have a per-context shadow, so simulate it by bulk-zeroing
each bank at fd2_emit_restore (per-batch). Mesa's emit_constants()
will then overwrite the slots the current shader actually uses; the
zero sweep prevents previous-client residue in unused slots from
being picked up by stray loads in compiled shaders.

This patch is a re-application of the previously-reverted mesa commits
bd9b43960f0 + 9e370652a6a. They were reverted because the report at
the time judged the resulting 3/8 (vs 1/8) hash convergence to be
"lucky phase alignment, not a real fix". A consistent 3x improvement
in correct-render rate is still shippable however; re-applying them
to validate whether the 3/8 reproduces on the current kernel state.

Cost: ~2300 dwords once per fd2_emit_restore (per batch).
Banks:
  type=0  ALU vec4 constants     - 2048 dwords (256 VS + 256 PS vec4s)
  type=1  texture/sampler descr  - 192 dwords  (32 x 6)
  type=2  bool flags             - 8 dwords    (256 bool flags)
  type=3  loop control           - 56 dwords

Upstream-Status: Pending
---
 src/gallium/drivers/freedreno/a2xx/fd2_emit.c | 49 +++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/src/gallium/drivers/freedreno/a2xx/fd2_emit.c b/src/gallium/drivers/freedreno/a2xx/fd2_emit.c
--- a/src/gallium/drivers/freedreno/a2xx/fd2_emit.c
+++ b/src/gallium/drivers/freedreno/a2xx/fd2_emit.c
@@ -472,6 +472,55 @@ fd2_emit_restore(struct fd_context *ctx, struct fd_ringbuffer *ring)
    OUT_PKT3(ring, CP_INVALIDATE_STATE, 1);
    OUT_RING(ring, 0x00007fff);

+   /*
+    * Bulk-zero all four shader-constant banks (A22X 3/8 alignment fix).
+    *
+    * Adreno 2xx exposes four classes of shader-constant memory via
+    * CP_SET_CONSTANT with type prefixes in the address word:
+    *   type=0 ALU vec4 (float) constants
+    *   type=1 texture-fetch constants
+    *   type=2 boolean constants
+    *   type=3 loop constants
+    *
+    * Mesa freedreno only emits type-0 (per-draw, via fd2_program
+    * emit_consts) and type-1 (per-binding, via texture state). It
+    * never emits type-2 or type-3. KGSL explicitly restored all four
+    * classes on every per-context shadow restore. Stale values cause
+    * the new shader to take wrong control-flow paths or read garbage.
+    *
+    * Mesa's emit_constants() will overwrite the slots the current
+    * shader actually uses; this sweep prevents previous-client
+    * residue in unused slots from being picked up by stray loads
+    * in compiled shaders.
+    */
+   {
+      const unsigned ALU_CONSTANTS  = 2048; /* 512 vec4 (256 VS + 256 PS) */
+      const unsigned TEX_CONSTANTS  = 192;  /* 32 samplers x 6 dwords */
+      const unsigned BOOL_CONSTANTS = 8;    /* 256 bool flags */
+      const unsigned LOOP_CONSTANTS = 56;   /* 56 loop control values */
+      unsigned i;
+
+      OUT_PKT3(ring, CP_SET_CONSTANT, 1 + ALU_CONSTANTS);
+      OUT_RING(ring, (0 << 16) | 0); /* type=0 ALU, offset=0 */
+      for (i = 0; i < ALU_CONSTANTS; i++)
+         OUT_RING(ring, 0x00000000);
+
+      OUT_PKT3(ring, CP_SET_CONSTANT, 1 + TEX_CONSTANTS);
+      OUT_RING(ring, (1 << 16) | 0); /* type=1 texture, offset=0 */
+      for (i = 0; i < TEX_CONSTANTS; i++)
+         OUT_RING(ring, 0x00000000);
+
+      OUT_PKT3(ring, CP_SET_CONSTANT, 1 + BOOL_CONSTANTS);
+      OUT_RING(ring, (2 << 16) | 0); /* type=2 boolean, offset=0 */
+      for (i = 0; i < BOOL_CONSTANTS; i++)
+         OUT_RING(ring, 0x00000000);
+
+      OUT_PKT3(ring, CP_SET_CONSTANT, 1 + LOOP_CONSTANTS);
+      OUT_RING(ring, (3 << 16) | 0); /* type=3 loop, offset=0 */
+      for (i = 0; i < LOOP_CONSTANTS; i++)
+         OUT_RING(ring, 0x00000000);
+   }
+
    OUT_PKT3(ring, CP_SET_CONSTANT, 2);
    OUT_RING(ring, CP_REG(REG_A2XX_SQ_VS_CONST));
    OUT_RING(ring, A2XX_SQ_VS_CONST_BASE(VS_CONST_BASE) |
