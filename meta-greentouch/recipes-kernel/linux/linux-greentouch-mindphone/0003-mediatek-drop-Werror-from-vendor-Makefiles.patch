From: LuneOS port <webos-ports@webos-ports.org>
Subject: [PATCH] mediatek: drop -Werror from vendor driver Makefiles

The MTK vendor drivers were only ever compiled with the BSP clang;
gcc 14 finds new (harmless) warnings in them and -Werror turns each
into a build break. Keep the warnings, drop the promotion.

Upstream-Status: Inappropriate [vendor driver, no upstream]
---
diff --git a/drivers/misc/mediatek/Makefile b/drivers/misc/mediatek/Makefile
index 967c75578496..081c4fe16f9f 100755
--- a/drivers/misc/mediatek/Makefile
+++ b/drivers/misc/mediatek/Makefile
@@ -14,7 +14,7 @@
 #$(call all-subdir-src-or-makefile)
 export MTK_PLATFORM_NAME := $(CONFIG_MTK_PLATFORM)
 export MTK_PLATFORM := $(subst ",,$(CONFIG_MTK_PLATFORM))
-subdir-ccflags-y += -Werror
+subdir-ccflags-y +=
 
 subdir-ccflags-y += -I$(srctree)/drivers/misc/mediatek/include
 subdir-ccflags-y += -I$(srctree)/drivers/misc/mediatek/include/mt-plat/$(MTK_PLATFORM)/include/
