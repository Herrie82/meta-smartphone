From: Herman van Hazendonk <github.com@herrie.org>
Date: Fri, 2 Oct 2026 00:00:00 +0200
Subject: [PATCH] drvgen: use the checked-in cust.dtsi instead of running DrvGen.py

drvgen.mk regenerates arch/arm64/boot/dts/<project>/cust.dtsi from the
project's .dws on every build, by running tools/dct/DrvGen.py through its
"#! /usr/bin/env python2" shebang. That script is Python 2 source (line 78 is
"print '''"), so on a host without python2 the build stops with

	env: 'python2': No such file or directory
	make[2]: *** [scripts/drvgen/drvgen.mk:49: arch/arm64/boot/dts/ot8/cust.dtsi] Error 127

The tree already carries the generator's output for this board:
arch/arm64/boot/dts/mediatek/ot8/cust.dtsi ("Generated by MTK SP DrvGen
Version: 3.5.160809 for MT6765", imported with the T225 release), and
ot8.dts pulls it in with #include "ot8/cust.dtsi", which resolves next to
ot8.dts. Prefer that file when it exists and fall back to running the tool
only when it does not.

FuriLabs' radon tree makes the same change (PREBUILT_CUST in its drvgen.mk).

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Inappropriate [MediaTek vendor build glue, exists only in the vendor tree]
---
--- a/scripts/drvgen/drvgen.mk
+++ b/scripts/drvgen/drvgen.mk
@@ -42,6 +42,7 @@ DRVGEN_FILE_LIST :=
 endif
 DRVGEN_TOOL := $(srctree)/tools/dct/DrvGen.py
 DRVGEN_FIG := $(wildcard $(dir $(DRVGEN_TOOL))config/*.fig)
+PREBUILT_CUST := $(srctree)/arch/$(SRCARCH)/boot/dts/mediatek/$(MTK_PROJECT)/cust.dtsi
 
 .PHONY: drvgen
 drvgen: $(DRVGEN_FILE_LIST)
@@ -51,7 +52,10 @@ $(DRVGEN_FILE_LIST): $(DRVGEN_TOOL) $(DWS_FILE) $(DRVGEN_FIG) $(PROJ_DTS_FILES)
 	       	| sed 's/\/cust\.dtsi[>"]//g' | sed 's/\/\*//g' | sed 's/\*\///g' | sed 's/ //g'`\
 		prj_path=$(DRVGEN_OUT)/$$base_prj ;\
 		dws_path=$(srctree)/$(DRVGEN_PATH)/$$base_prj.dws ;\
-		if [ -f $$dws_path ] ; then \
+		if [ -f $(PREBUILT_CUST) ] ; then \
+			mkdir -p $$prj_path ;\
+			cp $(PREBUILT_CUST) $$prj_path ;\
+		elif [ -f $$dws_path ] ; then \
 			mkdir -p $$prj_path ;\
 			$(python) $(DRVGEN_TOOL) $$dws_path $$prj_path $$prj_path cust_dtsi;\
 		fi \
